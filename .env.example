# Project 07 Configuration Environment Variables
# Safe defaults for local development and testing

P7_ENVIRONMENT=development
P7_API_TITLE="Project 07 Red Ingestion API"
P7_API_VERSION="1.0.0"
P7_HOST=127.0.0.1
P7_PORT=8000

# Authentication (enable in production)
P7_API_KEY_REQUIRED=false
P7_API_KEY=dev-insecure-test-key

# Ingestion constraints
P7_MAX_BATCH_SIZE=100
P7_STORAGE_TYPE=memory
