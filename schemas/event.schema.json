            "type": "object",
            "required": ["trigger_condition", "last_event_id", "total_elapsed_sec", "grace_period_sec", "recovery_permitted"],
            "properties": {
              "trigger_condition": { "type": "string", "enum": ["grace_period_expired", "handshake_timeout"] },
              "last_event_id": { "$ref": "#/$defs/uuid_v4" },
              "total_elapsed_sec": { "type": "number", "exclusiveMinimum": 0 },
              "grace_period_sec": { "type": "number", "minimum": 0 },
              "recovery_permitted": { "type": "boolean", "const": false }
            },
            "allOf": [
              {
                "if": { "properties": { "trigger_condition": { "const": "handshake_timeout" } } },
                "then": { "properties": { "grace_period_sec": { "const": 0 } } }
              },
              {
                "if": { "properties": { "trigger_condition": { "const": "grace_period_expired" } } },
                "then": { "properties": { "grace_period_sec": { "exclusiveMinimum": 0 } } }
              }
            ],
            "additionalProperties": false
          }
        }
      }
